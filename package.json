{
  "name": "brainyard-workspace",
  "private": true,
  "description": "Brainyard: @antondanv/brainyard (the API) and @antondanv/brainyard-cli (the brainyard command).",
  "license": "MIT",
  "author": "Anton Danilov",
  "type": "module",
  "workspaces": [
    "packages/brainyard",
    "packages/cli"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build --workspaces",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsx packages/cli/src/main.ts",
    "live": "tsx scripts/live-check.ts",
    "demo": "tsx scripts/demo.ts",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^22.20.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
