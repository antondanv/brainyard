{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    // Typecheck, tests and `npm run dev` see the API's sources, so the CLI never waits for a build.
    "paths": {
      "@antondanv/brainyard": ["./packages/brainyard/src/index.ts"]
    }
  },
  "include": ["packages/*/src", "packages/*/test", "scripts", "examples", "vitest.config.ts"]
}
